# As fotos das batidas (rostos) NUNCA são servidas direto: o administrador as
# abre por foto.php, que confere login e condomínio. O PHP lê o arquivo do disco
# por dentro, então isto não atrapalha.
Options -Indexes
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
